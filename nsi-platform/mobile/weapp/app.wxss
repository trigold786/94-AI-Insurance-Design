page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1F2937;
  font-size: 28rpx;
  box-sizing: border-box;
}

.primary-color { color: #1A56DB; }
.success-color { color: #059669; }
.danger-color { color: #EF4444; }
.bg-primary { background-color: #1A56DB; }
.bg-success { background-color: #059669; }
.bg-danger { background-color: #EF4444; }
.bg-page { background-color: #F5F7FA; }
.text-white { color: #FFFFFF; }
.text-gray { color: #6B7280; }
.text-dark { color: #1F2937; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 44rpx; }
.text-3xl { font-size: 52rpx; }
.font-bold { font-weight: 600; }
.font-medium { font-weight: 500; }
.text-center { text-align: center; }
.mt-2 { margin-top: 16rpx; }
.mt-4 { margin-top: 32rpx; }
.mt-6 { margin-top: 48rpx; }
.mt-8 { margin-top: 64rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mb-6 { margin-bottom: 48rpx; }
.p-4 { padding: 32rpx; }
.p-6 { padding: 48rpx; }
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }
.gap-2 { gap: 16rpx; }
.gap-4 { gap: 32rpx; }
.w-full { width: 100%; }
.rounded-lg { border-radius: 16rpx; }
.rounded-xl { border-radius: 24rpx; }
.rounded-full { border-radius: 9999rpx; }
.shadow-sm { box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06); }
.shadow-md { box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08); }
.shadow-lg { box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1); }

.btn-primary {
  background: linear-gradient(135deg, #1A56DB 0%, #2563EB 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-shadow: 0 4rpx 16rpx rgba(26, 86, 219, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-secondary {
  background: #FFFFFF;
  color: #1A56DB;
  border: 2rpx solid #1A56DB;
  border-radius: 48rpx;
  padding: 26rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 24rpx;
  padding: 0 32rpx;
}

.input-field {
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #1F2937;
  width: 100%;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #1A56DB;
}

.input-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
  display: block;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}
