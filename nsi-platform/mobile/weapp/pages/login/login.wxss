.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 120rpx 48rpx 80rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F0F5FF 100%);
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #1A56DB, #2563EB);
  border-radius: 40rpx;
  padding: 20rpx;
}

.login-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #6B7280;
  letter-spacing: 4rpx;
}

.login-features {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  width: 100%;
  margin: 80rpx 0;
}

.feature-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.feature-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
}

.feature-text {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.login-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.agreement-check {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  font-size: 24rpx;
}

.agreement-text-sm {
  color: #6B7280;
  font-size: 24rpx;
}

.link {
  color: #1A56DB;
  text-decoration: underline;
}

.login-btn {
  margin-bottom: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  border: none;
}

.login-btn[disabled] {
  opacity: 0.5;
  background: linear-gradient(135deg, #93B4F0 0%, #A0C0F5 100%);
}

.city-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #E5E7EB;
}

.city-label {
  font-size: 26rpx;
  color: #6B7280;
}

.city-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
}

.city-arrow {
  font-size: 20rpx;
  color: #9CA3AF;
}
