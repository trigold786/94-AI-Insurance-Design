.index-container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 40rpx;
}

.index-header {
  background: linear-gradient(135deg, #1A56DB 0%, #2563EB 100%);
  padding: 40rpx 32rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.location-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.location-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.location-city {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.location-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 8rpx;
}

.header-greeting {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.cta-section {
  padding: 0 32rpx;
  margin-top: -36rpx;
}

.cta-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.cta-desc {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  margin-bottom: 28rpx;
  line-height: 1.5;
}

.cta-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border: none;
}

.policy-section {
  padding-top: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
}

.section-more {
  font-size: 26rpx;
  color: #1A56DB;
}

.policy-list {
  padding: 0 32rpx;
}

.loading-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text, .empty-text {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #9CA3AF;
}
