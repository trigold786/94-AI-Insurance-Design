.page-title { font-size: 36rpx; font-weight: 700; margin: 20rpx 0; }

.summary-row { display: flex; gap: 16rpx; margin: 16rpx 0; }
.summary-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.summary-num { font-size: 40rpx; font-weight: 700; display: block; }
.summary-label { font-size: 24rpx; color: #6B7280; display: block; margin-top: 8rpx; }
.summary-card.paid .summary-num { color: #059669; }
.summary-card.pending .summary-num { color: #F59E0B; }
.summary-card.missed .summary-num { color: #EF4444; }

.section { margin: 24rpx 0; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; display: block; }
.empty-tip { font-size: 26rpx; color: #9CA3AF; text-align: center; display: block; padding: 20rpx; }

.alert-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.alert-header { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.alert-severity {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.alert-severity.high { background: #FEE2E2; color: #EF4444; }
.alert-severity.medium { background: #FEF3C7; color: #F59E0B; }
.alert-severity.low { background: #DBEAFE; color: #3B82F6; }
.alert-type { font-size: 22rpx; color: #6B7280; }
.alert-read { font-size: 20rpx; color: #9CA3AF; margin-left: auto; }
.alert-title { font-size: 28rpx; font-weight: 600; color: #333; display: block; margin-bottom: 4rpx; }
.alert-msg { font-size: 24rpx; color: #6B7280; display: block; }

.record-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  gap: 12rpx;
}
.record-month { font-size: 26rpx; color: #374151; width: 100rpx; }
.record-type { font-size: 24rpx; color: #6B7280; flex: 1; }
.record-amount { font-size: 24rpx; color: #333; }
.record-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.record-status.paid { background: #D1FAE5; color: #059669; }
.record-status.pending { background: #FEF3C7; color: #F59E0B; }
.record-status.missed { background: #FEE2E2; color: #EF4444; }
