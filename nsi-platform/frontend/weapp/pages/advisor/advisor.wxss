page { height: 100%; }
.chat-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F7FA;
}
.chat-scroll { flex: 1; }
.msg-list { padding: 24rpx 24rpx 0; }
.msg-row { display: flex; margin-bottom: 20rpx; }
.msg-row .bubble.user { margin-left: auto; }
.bubble {
  max-width: 76%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.bubble.assistant {
  background: #fff;
  color: #1F2937;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.bubble.user {
  background: #1A56DB;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.bubble.loading { color: #9CA3AF; font-size: 26rpx; }
.msg-bottom { height: 24rpx; }

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #EEF0F4;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F3F4F6;
  border-radius: 36rpx;
  font-size: 28rpx;
}
.send-btn {
  background: #1A56DB;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border: none;
}
.send-btn[disabled] { background: #9DB6E8; color: #fff; }
