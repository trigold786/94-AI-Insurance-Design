.step-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 30rpx 0;
}
.step {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #9CA3AF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.step.active { background: #1A56DB; color: #fff; }
.step-line {
  width: 80rpx;
  height: 4rpx;
  background: #E5E7EB;
  margin: 0 12rpx;
}
.step-line.active { background: #1A56DB; }

.form-step { margin-top: 20rpx; }
.step-title { font-size: 36rpx; font-weight: 700; margin-bottom: 32rpx; display: block; }
.form-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
}
.label { font-size: 30rpx; color: #374151; }
.value { font-size: 30rpx; color: #1A56DB; }
.input { font-size: 30rpx; text-align: right; color: #333; }
.btn-row { display: flex; gap: 20rpx; margin-top: 40rpx; }
.btn-secondary {
  flex: 1;
  background: #fff;
  border: 2rpx solid #D1D5DB;
  color: #374151;
  border-radius: 48rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
}
.error-msg {
  color: #EF4444;
  font-size: 26rpx;
  text-align: center;
  margin-top: 20rpx;
}
