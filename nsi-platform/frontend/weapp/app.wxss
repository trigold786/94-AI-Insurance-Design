page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #1F2937;
  font-size: 28rpx;
  line-height: 1.5;
}
.container { padding: 24rpx 32rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-header {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #1A56DB, #3B82F6);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.btn-primary:active { opacity: 0.85; }
.btn-secondary {
  background: #fff;
  color: #1A56DB;
  border: 2rpx solid #1A56DB;
  border-radius: 48rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-secondary:active { background: #EFF6FF; }
.btn-small {
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  border-radius: 32rpx;
  display: inline-block;
}
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.badge-green { background: #D1FAE5; color: #059669; }
.badge-yellow { background: #FEF3C7; color: #D97706; }
.badge-red { background: #FEE2E2; color: #EF4444; }
.badge-blue { background: #DBEAFE; color: #1A56DB; }
.text-muted { color: #9CA3AF; font-size: 24rpx; }
.text-error { color: #EF4444; font-size: 24rpx; }
.text-primary { color: #1A56DB; }
.text-success { color: #059669; }
.text-center { text-align: center; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-1 { flex: 1; }
.gap-8 { gap: 8rpx; }
.gap-16 { gap: 16rpx; }
.loading-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.9);
  display: flex; justify-content: center; align-items: center;
  z-index: 999;
}
.empty-state {
  text-align: center; padding: 80rpx 40rpx;
  color: #9CA3AF; font-size: 26rpx;
}
