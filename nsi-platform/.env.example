# IMPORTANT: Copy this file to .env and replace ALL placeholder values

COMPOSE_PROJECT_NAME=94-nsip

# Database
DATABASE_URL=postgres://localhost:35432/nsi?sslmode=disable
POSTGRES_PASSWORD=<set-a-strong-password>

# Redis
REDIS_URL=redis://localhost:36379/0

# JWT (for auth gateway integration)
JWT_SECRET=<generate-a-random-64-char-string>

# LLM API (for policy-crawler)
LLM_API_KEY=
LLM_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# Actuarial Engine gRPC
ACTUARY_GRPC_ADDR=localhost:50051

# Actuarial Engine shared secret
ACTUARY_SECRET=<set-a-shared-secret>

# Object Storage (MinIO for dev, OSS for prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=<set-access-key>
STORAGE_SECRET_KEY=<set-secret-key>
STORAGE_BUCKET=nsi-reports
MINIO_ROOT_USER=<set-minio-user>
MINIO_ROOT_PASSWORD=<set-minio-password>

# SMS (for notifications, Phase 2)
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
